{
  "name": "@wiro-ai/ai-sdk-provider",
  "version": "0.1.0",
  "description": "Wiro AI provider for the Vercel AI SDK. Run any model on the Wiro LLM gateway with generateText, streamText, tools and structured output, and read what each call cost.",
  "keywords": [
    "wiro",
    "wiro-ai",
    "ai",
    "ai-sdk",
    "vercel-ai",
    "provider",
    "llm",
    "llm-gateway",
    "openai-compatible"
  ],
  "homepage": "https://wiro.ai/llm",
  "bugs": {
    "url": "https://github.com/wiroai/Wiro-LLM/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wiroai/Wiro-LLM.git"
  },
  "license": "MIT",
  "author": "Wiro AI",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.87",
    "@ai-sdk/provider": "^4.0.37",
    "@ai-sdk/provider-utils": "^5.0.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^22.20.5",
    "ai": "^7.0.166",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
